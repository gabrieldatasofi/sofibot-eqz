__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv*/
.pytest_cache/
.vscode/
.tmp/

# Credenciales
.env
.env.*
!.env.example
!.env.consultas.example
secretos*.env

# Borradores escritos por la API de informes (docs/10-api-informes.md)
# (en cualquier carpeta reports/, también la de Contoso; tienen correos de usuarios)
.borradores/
.admin/

# Usuarios y roles (docs/09-inicio-sesion-entra.md): tienen correos de personas.
# Cuentas locales: hashes de contraseñas de cada instalación. Copias que guarda la
# administración al cambiar usuarios o permisos.
usuarios.json
cuentas-locales.json
/acceso/permisos.json
.copias/

# Registro del servicio de consultas (docs/11-consultas.md)
/consultas/

# Informes generados y ficheros de datos: nunca en git.
output/*
!output/.gitkeep
examples/contoso/output/
examples/contoso/consultas/
*.xlsx
*.csv
*.parquet
*.bak
*.tar

# Guía interna de Datasofi: no se entrega a clientes.
GUIA-DATASOFI.md

# Permisos locales de Claude Code de cada persona
.claude/settings.local.json

# Certificado y clave privada del proxy HTTPS
caddy/certs/*
!caddy/certs/.gitkeep

# Conectores MCP compilados (mcp-server/build-exe.ps1): se generan en cada versión, no van en git
mcp-server/dist/

# Paquetes de instalación generados por publicar-imagen.ps1
dist-instalacion/
