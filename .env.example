# Copiar a .env y rellenar. Referencia completa: docs/configuracion.md
# .env contiene contraseñas: no lo subas a git ni lo envíes por correo.

# --- SQL Server (login de solo lectura: sql/crear-login-lectura.sql) ---
# Servidor: nombre o IP. Desde Docker, un SQL Server del mismo equipo es host.docker.internal
SQLSERVER_HOST=host.docker.internal
# Puerto TCP. Vacío para una instancia con nombre (SQLSERVER_HOST=servidor\INSTANCIA).
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
# sql (usuario y contraseña de SQL Server) | entra-sp (Azure SQL / Fabric, principal de servicio)
# | windows (solo fuera de Docker, con el usuario de Windows que lo ejecuta)
SQLSERVER_AUTH=sql
SQLSERVER_USER=sofibot_lectura
SQLSERVER_PASSWORD=
# Esquema donde están las tablas o vistas Gold.
SQLSERVER_GOLD_SCHEMA=gold
# Cifrado: yes (recomendado) | strict | no
SQLSERVER_ENCRYPT=yes
# 1 acepta un certificado autofirmado. Solo para pruebas en un SQL Server local.
SQLSERVER_TRUST_CERTIFICATE=0
# Segundos máximos por consulta.
SQLSERVER_QUERY_TIMEOUT=300

# --- Portal ---
# Token para la API de administración (/api/admin/...). Mínimo 32 caracteres.
# Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
SOFIBOT_ADMIN_TOKEN=
# Si se rellena, el portal pide usuario y contraseña (recomendado si no está detrás de un proxy con login).
SOFIBOT_VIEWER_USER=equivalenza
SOFIBOT_VIEWER_PASSWORD=
# Horas de regeneración automática de todos los informes (hora de TZ), separadas por comas. Vacío = desactivado.
SOFIBOT_BUILD_SCHEDULE=06:00
TZ=Europe/Madrid
# Interfaz y puerto publicados por Docker. 127.0.0.1 = solo este equipo; 0.0.0.0 = toda la red.
SOFIBOT_BIND=127.0.0.1
SOFIBOT_PORT=8080
