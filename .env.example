# Copiar a .env y rellenar. Referencia completa: docs/configuracion.md
# .env contiene contraseñas: no lo subas a git ni lo envíes por correo. En producción Linux,
# las contraseñas y tokens van en /etc/sofibot/secretos.env (plantilla: secretos.env.example).

# --- SQL Server (login de solo lectura: sql/crear-login-lectura.sql) ---
# Servidor: nombre o IP. Desde Docker, un SQL Server del mismo equipo es host.docker.internal
SQLSERVER_HOST=host.docker.internal
# Puerto TCP. Vacío para una instancia con nombre (SQLSERVER_HOST=servidor\INSTANCIA).
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
# sql (usuario y contraseña de SQL Server) | entra-sp (Azure SQL / Fabric, principal de servicio)
# | windows (solo fuera de Docker, con el usuario de Windows que lo ejecuta)
SQLSERVER_AUTH=sql
SQLSERVER_USER=sofibot_lectura
SQLSERVER_PASSWORD=
# Esquema donde están las tablas o vistas Gold.
SQLSERVER_GOLD_SCHEMA=gold
# Cifrado: yes (recomendado) | strict | no
SQLSERVER_ENCRYPT=yes
# 1 acepta un certificado autofirmado. Solo para pruebas en un SQL Server local.
SQLSERVER_TRUST_CERTIFICATE=0
# Segundos máximos por consulta.
SQLSERVER_QUERY_TIMEOUT=300

# --- Portal ---
# Token para la API de administración (/api/admin/...). Mínimo 32 caracteres.
# Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
SOFIBOT_ADMIN_TOKEN=
# Funcionalidad 1, API de esquema e informes para asistentes de IA (/api/code/..., docs/10-api-informes.md):
# off (por defecto) | entra (cada autor con su cuenta de Microsoft y el rol Sofibot.Autor) |
# token (un token compartido, solo para pruebas: no se sabe quién hizo qué).
SOFIBOT_CODE_API=off
# Solo con SOFIBOT_CODE_API=token. Mínimo 32 caracteres y distinto de SOFIBOT_ADMIN_TOKEN.
SOFIBOT_API_TOKEN=
# 1 = un revisor puede publicar un borrador que envió él mismo (por defecto, no).
#SOFIBOT_REVIEW_OWN=0
# Funcionalidad 2, consultas de datos: COMPOSE_PROFILES=consultas y su propio .env.consultas
# (docs/11-consultas.md). Con HTTPS: COMPOSE_PROFILES=https,consultas.
#SOFIBOT_QUERY_PORT=8081
# Con el servicio de consultas activo: activa la página Consultas del portal.
#SOFIBOT_QUERY_URL=http://consultas:8080
# Inicio de sesión: entra (cada persona con su cuenta, ve los informes de su rol) | basic | none.
# Vacío: basic si SOFIBOT_VIEWER_PASSWORD tiene valor, none si no.
SOFIBOT_AUTH=
# basic: un usuario y una contraseña compartidos.
SOFIBOT_VIEWER_USER=equivalenza
SOFIBOT_VIEWER_PASSWORD=
# entra (docs/09-inicio-sesion-entra.md): datos del registro de la aplicación en Entra ID.
# Entra ID solo valida el inicio de sesión. Roles de cada persona: acceso/usuarios.json; tablas de
# cada rol de datos: acceso/permisos.json. Se editan en Administración. Primer administrador:
#   docker compose run --rm sofibot sofibot users add <correo> Sofibot.Admin
#SOFIBOT_PUBLIC_URL=https://informes.empresa.local
#ENTRA_TENANT_ID=
#ENTRA_CLIENT_ID=
#ENTRA_CLIENT_SECRET=
#SOFIBOT_SESSION_HOURS=8
# Horas de regeneración automática de todos los informes (hora de TZ), separadas por comas. Vacío = desactivado.
SOFIBOT_BUILD_SCHEDULE=06:00
TZ=Europe/Madrid
# Interfaz y puerto publicados por Docker. 127.0.0.1 = solo este equipo; 0.0.0.0 = toda la red.
SOFIBOT_BIND=127.0.0.1
SOFIBOT_PORT=8080

# --- Proxy HTTPS para abrir el portal desde la red (docs/08-acceso-https.md) ---
# Descomentar para activarlo (publica los puertos 80 y 443 del servidor).
#COMPOSE_PROFILES=https
# Nombre del portal, dado de alta en el DNS interno.
#SOFIBOT_DOMAIN=informes.empresa.local
# Certificado: internal | "/certs/cert.pem /certs/key.pem" (corporativo, en caddy/certs/) | correo (Let's Encrypt)
#SOFIBOT_TLS=internal
