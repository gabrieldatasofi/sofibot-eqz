# Producción en Linux: contraseñas y tokens del portal fuera de la carpeta de Sofibot.
# Copiar a /etc/sofibot/secretos.env (dueño root, permisos 600) y rellenar. Lo que pongáis
# aquí tiene prioridad sobre .env: dejad estas variables vacías en .env.
# Guía: INSTALAR.md, "Producción en Linux: secretos fuera de la carpeta".

# Contraseña del login de solo lectura (sofibot_lectura).
SQLSERVER_PASSWORD=
# Token de la API de administración, 32 caracteres o más:  openssl rand -base64 30
SOFIBOT_ADMIN_TOKEN=
# Con inicio de sesión de Microsoft (SOFIBOT_AUTH=entra): el secreto del registro de la aplicación.
#ENTRA_CLIENT_SECRET=
# Solo con SOFIBOT_AUTH=basic.
#SOFIBOT_VIEWER_PASSWORD=
# Solo con SOFIBOT_CODE_API=token (pruebas).
#SOFIBOT_API_TOKEN=
# Con cuentas locales: firma de sus tokens. El mismo valor en secretos-consultas.env.
#SOFIBOT_LOCAL_SECRET=
