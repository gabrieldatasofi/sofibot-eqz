# Funcionalidad 2: servicio de consultas de datos (docs/11-consultas.md).
# Copiar a .env.consultas. Es un fichero aparte de .env: este contenedor no recibe la
# configuración del portal, y el portal no recibe la de este. En producción Linux, la
# contraseña va en /etc/sofibot/secretos-consultas.env (plantilla: secretos-consultas.env.example).

# Interruptor: 1 = activado. Cualquier otro valor deja el servicio respondiendo 503.
SOFIBOT_QUERY_ENABLED=1

# --- SQL Server: un login propio, distinto del del portal (sql/crear-login-lectura.sql con
# @login = N'sofibot_consultas'). Solo lectura sobre el esquema Gold.
SQLSERVER_HOST=host.docker.internal
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
SQLSERVER_AUTH=sql
SQLSERVER_USER=sofibot_consultas
SQLSERVER_PASSWORD=
SQLSERVER_GOLD_SCHEMA=gold
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_CERTIFICATE=0
# Segundos máximos por consulta: más corto que en los builds.
SQLSERVER_QUERY_TIMEOUT=30

# --- Microsoft Entra ID: los mismos ids que el portal. Sin secreto: solo comprueba tokens.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# --- Límites
SOFIBOT_QUERY_MAX_ROWS=1000
SOFIBOT_QUERY_PER_MINUTE=30

# --- Registro (consultas/registro.sqlite). Nunca guarda los valores devueltos.
# 1 = guardar también el texto de las preguntas (decisión de EQZ), y borrarlo tras N días.
SOFIBOT_QUERY_STORE_QUESTIONS=0
SOFIBOT_QUERY_QUESTION_DAYS=90

TZ=Europe/Madrid
