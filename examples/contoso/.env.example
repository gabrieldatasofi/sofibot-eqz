# Entorno de pruebas Contoso (solo Datasofi). Copiar a examples/contoso/.env y rellenar.
# Solo la base pública Contoso: nunca credenciales ni servidores de un cliente.

# SQL Server de pruebas de este equipo, visto desde Docker.
SQLSERVER_HOST=host.docker.internal
SQLSERVER_PORT=1433
# ContosoRetailDW o ContosoV2, la que esté restaurada (y con 01-crear-gold.sql ejecutado).
SQLSERVER_DATABASE=ContosoRetailDW
SQLSERVER_AUTH=sql
# Login creado en esta base con sql/crear-login-lectura.sql.
SQLSERVER_USER=sofibot_lectura
SQLSERVER_PASSWORD=
SQLSERVER_GOLD_SCHEMA=gold
SQLSERVER_ENCRYPT=yes
# SQL Server local con certificado autofirmado.
SQLSERVER_TRUST_CERTIFICATE=1
SQLSERVER_QUERY_TIMEOUT=300

# Portal de pruebas: solo este equipo, sin login, sin regeneración automática.
# Generar el token: python -c "import secrets; print(secrets.token_urlsafe(48))"
SOFIBOT_ADMIN_TOKEN=
SOFIBOT_VIEWER_PASSWORD=
SOFIBOT_BUILD_SCHEDULE=
TZ=Europe/Madrid
SOFIBOT_PORT=8085

# Inicio de sesión con Entra ID de Datasofi (README, "Probar el inicio de sesión con Entra ID").
#SOFIBOT_AUTH=entra
#SOFIBOT_PUBLIC_URL=http://localhost:8085
#ENTRA_TENANT_ID=
#ENTRA_CLIENT_ID=
#ENTRA_CLIENT_SECRET=

# Proxy HTTPS para probar desde otro equipo (README, "Probar desde otro equipo de la red").
#COMPOSE_PROFILES=https
#SOFIBOT_DOMAIN=192-168-1-50.nip.io
#SOFIBOT_TLS=internal
