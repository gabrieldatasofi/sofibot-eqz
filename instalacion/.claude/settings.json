{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.consultas)",
      "Read(**/.env.local)",
      "Read(**/secretos.env)",
      "Read(**/secretos-consultas.env)",
      "Read(//etc/sofibot/**)",
      "Read(**/*.bak)",
      "Read(**/output/**)",
      "Read(**/consultas/**)",
      "Read(**/reports/.admin/**)",
      "Read(**/caddy/certs/**)",
      "Read(**/*.xlsx)",
      "Read(**/*.csv)",
      "Read(**/*.parquet)",
      "Read(**/*.sqlite)",
      "Edit(**/.env)",
      "Edit(**/.env.consultas)",
      "Bash(sqlcmd:*)",
      "Bash(sofibot:*)",
      "Bash(docker compose run:*)",
      "Bash(docker compose --profile:*)",
      "Bash(docker compose exec:*)",
      "Bash(docker compose cp:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker run:*)",
      "Bash(docker exec:*)",
      "Bash(docker cp:*)",
      "Bash(docker inspect:*)",
      "Bash(docker logs:*)",
      "Bash(docker login:*)",
      "Bash(docker-compose:*)",
      "Bash(cat .env:*)",
      "Bash(cat .env.consultas:*)",
      "Bash(type .env:*)",
      "Bash(more .env:*)",
      "Bash(less .env:*)",
      "Bash(head .env:*)",
      "Bash(tail .env:*)",
      "Bash(grep:*)",
      "Bash(findstr:*)",
      "Bash(Get-Content .env:*)",
      "Bash(gc .env:*)",
      "Bash(Select-String:*)",
      "Bash(env)",
      "Bash(printenv:*)"
    ]
  }
}
